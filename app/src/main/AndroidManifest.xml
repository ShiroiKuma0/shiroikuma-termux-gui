<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:sharedUserId="com.termux">
    
    <!-- According to google surveys EGL2.0 should be available on all devices anyways, but you should declare it in the manifest. -->
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="false" />

    <!-- Used to keep the app from getting killed even when no clients how Activities in the foreground. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Used for overlay Activities. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Used to turn on the display. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Used on Android 13 for the foreground service notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- shiroikuma-termux-gui fork: the 保存復元 automation's dataSync foreground services
         (StateExportService, AutomationDataService) — required at targetSdk 34. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- shiroikuma-termux-gui fork: without these, the reply broadcasts' setPackage() to the two
         automation callers fail SILENTLY on Android 11+ (sister-app contract v2 §2a). -->
    <queries>
        <package android:name="shiroikuma.oyokanri" />
        <package android:name="shiroikuma.jiyusagyoban" />
    </queries>
    
    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TermuxGUI">
        <activity
            android:name=".GUIConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- shiroikuma-termux-gui fork: launcher long-press → the 白い熊 Termux GUI UI page. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <receiver
            android:name=".PendingIntentReceiver"
            android:exported="false" />
        <receiver
            android:name=".GUIWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget" />
        </receiver>
        <receiver
            android:name=".ServiceShutdownReceiver"
            android:enabled="true"
            android:exported="false" />

        <activity
            android:name=".GUIWidgetConfigurationActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".GUIActivity"
            android:configChanges="uiMode|locale|screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="false"
            android:supportsPictureInPicture="true"
            android:alwaysRetainTaskState="true"
            android:persistableMode="persistNever"/>
        <activity
            android:name=".GUIActivityLockscreen"
            android:configChanges="uiMode|locale|screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="false"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:supportsPictureInPicture="true"
            android:alwaysRetainTaskState="true"
            android:persistableMode="persistNever"
            tools:targetApi="o_mr1" />
        <activity
            android:name=".GUIActivityDialog"
            android:configChanges="uiMode|locale|screenSize|smallestScreenSize|screenLayout|orientation"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/TermuxAlertDialogStyle" />
        <activity
            android:name=".GUIWebViewJavascriptDialog"
            android:exported="false"
            android:theme="@style/TermuxAlertDialogStyle" />

        <service
            android:name=".GUIService"
            android:foregroundServiceType="specialUse"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".GUIReceiver"
            android:enabled="true"
            android:exported="false" />
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <!-- ===== shiroikuma-termux-gui fork: the 白い熊 Termux GUI UI page, Export / Import, and the
             sister-app backup-automation contract v2 (自由作業盤 保存復元 / 応用管理). Additive; every
             component lives under com.termux.gui.shiroikuma. ===== -->

        <!-- The page. Exported so the static launcher shortcut (a different process) can start it. -->
        <activity
            android:name=".shiroikuma.ShiroikumaUiActivity"
            android:label="@string/shiroikuma_ui_title"
            android:exported="true" />

        <!-- §1: EXPORT_STATE / LIST_CATEGORIES / CANCEL_EXPORT. Deliberately no permission: the
             gate is the switch + optional token; this half only ever writes where it is told to. -->
        <receiver
            android:name=".shiroikuma.automation.StateExportReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="${applicationId}.action.EXPORT_STATE" />
                <action android:name="${applicationId}.action.LIST_CATEGORIES" />
                <action android:name="${applicationId}.action.CANCEL_EXPORT" />
            </intent-filter>
        </receiver>

        <!-- §2a: the data door — describe / export / import / cancel via call(), caller verified
             by exact name + uid + pinned signing certificate (AutomationCallers). -->
        <provider
            android:name=".shiroikuma.automation.AutomationProvider"
            android:authorities="${applicationId}.automation"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Where the two doors' work runs, off the broadcast / binder windows. -->
        <service
            android:name=".shiroikuma.automation.StateExportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".shiroikuma.automation.AutomationDataService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Capability discovery, readable by 応用管理 without waking (or thawing) this app.
             INTEGERS — the reader uses getInt. -->
        <meta-data android:name="shiroikuma.automation.contract" android:value="2" />
        <meta-data android:name="shiroikuma.automation.format" android:value="1" />
        <meta-data android:name="shiroikuma.automation.min_format" android:value="1" />
    </application>

</manifest>